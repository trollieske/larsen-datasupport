<h1>Hardware — kortvegg</h1>

<% if @edit_item %>
  <section class="card">
    <h2>Rediger vare: <%= h(@edit_item["name"]) %></h2>
    <form method="post" action="/hardware/<%= @edit_item['id'] %>" class="grid-form" enctype="multipart/form-data">
      <div class="field">
        <label>Navn</label>
        <input type="text" name="name" value="<%= h(@edit_item['name']) %>" required maxlength="200">
      </div>
      <div class="field">
        <label>Kategori</label>
        <select name="category">
          <% CATEGORIES.each do |c| %><option <%= "selected" if @edit_item['category'] == c %>><%= c %></option><% end %>
        </select>
      </div>
      <div class="field">
        <label>Kostpris (kr)</label>
        <input type="text" name="cost_price" inputmode="decimal" value="<%= kr_input(@edit_item['cost_price']) %>">
      </div>
      <div class="field">
        <label>Salgspris (kr)</label>
        <input type="text" name="sale_price" inputmode="decimal" value="<%= kr_input(@edit_item['sale_price']) %>">
      </div>
      <div class="field">
        <label>Antall på lager</label>
        <input type="number" name="quantity_in_stock" min="0" value="<%= @edit_item['quantity_in_stock'] %>">
      </div>
      <div class="field">
        <label>Foto (valgfritt — nytt bilde erstatter)</label>
        <input type="file" name="photo" accept="image/*">
      </div>
      <div class="field">
        <label>Notater</label>
        <input type="text" name="notes" value="<%= h(@edit_item['notes']) %>" maxlength="300">
      </div>
      <div class="field align-end">
        <div class="actions">
          <button type="submit" class="btn primary">Lagre endringer</button>
          <a class="btn" href="/hardware">Avbryt</a>
        </div>
      </div>
    </form>
  </section>
<% end %>

<section class="card add-card">
  <h2>Legg til vare</h2>
  <form method="post" action="/hardware" class="grid-form" enctype="multipart/form-data"
        hx-post="/hardware" hx-target="#cards" hx-swap="innerHTML" hx-encoding="multipart/form-data">
    <div class="field">
      <label>Navn</label>
      <input type="text" name="name" required maxlength="200" placeholder="Dell P2422H 24&quot;">
    </div>
    <div class="field">
      <label>Kategori</label>
      <select name="category">
        <% CATEGORIES.each do |c| %><option><%= c %></option><% end %>
      </select>
    </div>
    <div class="field">
      <label>Kostpris (kr)</label>
      <input type="text" name="cost_price" inputmode="decimal" placeholder="1100">
    </div>
    <div class="field">
      <label>Salgspris (kr)</label>
      <input type="text" name="sale_price" inputmode="decimal" placeholder="1650">
    </div>
    <div class="field">
      <label>Antall på lager</label>
      <input type="number" name="quantity_in_stock" min="0" value="1">
    </div>
    <div class="field">
      <label>Foto (valgfritt)</label>
      <input type="file" name="photo" accept="image/*">
    </div>
    <div class="field">
      <label>Notater</label>
      <input type="text" name="notes" maxlength="300">
    </div>
    <div class="field align-end">
      <button type="submit" class="btn primary big">＋ Legg til vare</button>
    </div>
  </form>
</section>

<section class="card">
  <div class="card-head">
    <h2>Lageret</h2>
    <div class="search-wrap">
      <%= @customers.count %> kunder-referanser
    </div>
  </div>
  <%= erb :_cards, layout: false %>
</section>

<script>
// Kopier ferdigformatert salgstekst ett trykk.
document.addEventListener("click", function (e) {
  var b = e.target.closest(".copy-btn");
  if (!b) return;
  var text = b.getAttribute("data-copy");
  navigator.clipboard.writeText(text).then(function () {
    var s = b.querySelector("span");
    var old = s.textContent;
    s.textContent = "Kopiert ✓";
    setTimeout(function () { s.textContent = old; }, 1500);
  });
});
// Lukk «Selg»-popup ved klikk utenfor.
document.addEventListener("click", function (e) {
  document.querySelectorAll("details.sell-details[open]").forEach(function (d) {
    if (!d.contains(e.target)) d.removeAttribute("open");
  });
});
</script>