<div class="dash-head">
  <div>
    <h1 class="dash-title">Oversikt</h1>
    <p class="dash-sub muted">Velkommen til Larsen Datasupport — din bedrifts kontrollpanel.</p>
  </div>
  <div class="dash-actions">
    <a class="btn primary" href="/timer"><%= erb :_icon, locals: { name: "play", size: 16 } %> Start timer</a>
    <a class="btn ghost" href="/hardware"><%= erb :_icon, locals: { name: "box", size: 16 } %> Registr salg</a>
  </div>
</div>

<div class="kpi-row">
  <article class="kpi">
    <div class="kpi-icon"><%= erb :_icon, locals: { name: "timer", size: 20 } %></div>
    <div class="kpi-body">
      <p class="kpi-label">Denne måneden</p>
      <p class="kpi-value"><%= format_kr(@month_amount) %></p>
      <p class="kpi-sub"><%= fmt_minutes(@month_minutes) %> fakturerbare timer</p>
    </div>
  </article>
  <article class="kpi">
    <div class="kpi-icon"><%= erb :_icon, locals: { name: "wallet", size: 20 } %></div>
    <div class="kpi-body">
      <p class="kpi-label">Ufakturert</p>
      <p class="kpi-value"><%= format_kr(@uninvoiced_total) %></p>
      <p class="kpi-sub"><%= format_kr(@uninvoiced_subtotal) %> uten mva</p>
    </div>
  </article>
  <article class="kpi">
    <div class="kpi-icon"><%= erb :_icon, locals: { name: "box", size: 20 } %></div>
    <div class="kpi-body">
      <p class="kpi-label">Lagerverdi</p>
      <p class="kpi-value"><%= format_kr(@stock_value) %></p>
      <p class="kpi-sub"><%= @stock_count %> stk på lager</p>
    </div>
  </article>
</div>

<div class="chart-grid">
  <section class="card chart-card">
    <div class="card-head">
      <h2>Timer — siste 14 dager</h2>
      <span class="tag">minutter</span>
    </div>
    <%= erb :_bar_chart, layout: false, locals: { data: @days } %>
  </section>
  <section class="card chart-card">
    <div class="card-head">
      <h2>Omsetning — siste 6 måneder</h2>
      <span class="tag">kroner</span>
    </div>
    <%= erb :_line_chart, layout: false, locals: { data: @months } %>
  </section>
</div>

<% if @suggestions && !@suggestions.empty? %>
<section class="card sugg-card">
  <div class="card-head"><h2>Trenger oppfølging — la appen peke deg</h2></div>
  <div class="sugg-list">
    <% @suggestions.each do |s| %>
      <a class="sugg-item" href="<%= h(s[:href]) %>">
        <span class="sugg-emoji"><% ico = { "🧾" => "invoice", "📦" => "box", "⏱" => "timer", "💬" => "message", "🏷" => "wallet" }.fetch(s[:icon], "check") %><%= erb :_icon, locals: { name: ico, size: 18 } %></span>
        <span class="sugg-text"><%= h(s[:text]) %></span>
        <span class="sugg-arrow"><%= erb :_icon, locals: { name: "forward", size: 14 } %></span>
      </a>
    <% end %>
  </div>
</section>
<% end %>

<section class="card">
  <div class="card-head"><h2>Siste aktivitet</h2></div>
  <% if @activity.empty? %>
    <p class="muted">Ingenting ennå — start en timer eller registrer et salg.</p>
  <% else %>
    <div class="activity">
      <% @activity.each do |a| %>
        <div class="activity-item">
          <span class="act-time muted"><%= h(fmt_date(a[:at])) %></span>
          <span class="act-text"><%= h(a[:text]) %></span>
        </div>
      <% end %>
    </div>
  <% end %>
</section>