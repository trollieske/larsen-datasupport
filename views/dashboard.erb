<div class="dash-head">
  <div>
    <h1 class="dash-title">Oversikt</h1>
    <p class="dash-sub muted">Velkommen til Larsen Datasupport — din bedrifts kontrollpanel.</p>
  </div>
  <div class="dash-actions">
    <a class="btn primary" href="/timer">▶ Start timer</a>
    <a class="btn ghost" href="/hardware">+ Legg til vare</a>
  </div>
</div>

<div class="kpi-row">
  <article class="kpi">
    <div class="kpi-icon" style="--c:#4f8cff">🕐</div>
    <div class="kpi-body">
      <p class="kpi-label">Denne måneden</p>
      <p class="kpi-value"><%= format_kr(@month_amount) %></p>
      <p class="kpi-sub"><%= fmt_minutes(@month_minutes) %> fakturerbare timer</p>
    </div>
    <span class="kpi-chip good">+</span>
  </article>
  <article class="kpi">
    <div class="kpi-icon" style="--c:#3ecf7e">💰</div>
    <div class="kpi-body">
      <p class="kpi-label">Ufakturert — venter på deg</p>
      <p class="kpi-value"><%= format_kr(@uninvoiced_total) %></p>
      <p class="kpi-sub"><%= format_kr(@uninvoiced_subtotal) %> uten mva</p>
    </div>
  </article>
  <article class="kpi">
    <div class="kpi-icon" style="--c:#9a66ff">📦</div>
    <div class="kpi-body">
      <p class="kpi-label">Lager</p>
      <p class="kpi-value"><%= @stock_count %></p>
      <p class="kpi-sub"><%= @customer_count %> kunder</p>
    </div>
  </article>
</div>

<div class="chart-grid">
  <section class="card chart-card">
    <div class="card-head">
      <h2>Timer — siste 14 dager</h2>
      <span class="tag">minutter</span>
    </div>
    <%= erb :_bar_chart, layout: false, locals: { data: @days } %>
  </section>
  <section class="card chart-card">
    <div class="card-head">
      <h2>Omsetning — siste 6 måneder</h2>
      <span class="tag">kroner</span>
    </div>
    <%= erb :_line_chart, layout: false, locals: { data: @months } %>
  </section>
</div>

<% if @active %>
<section class="card live-timer">
  <div class="live-info">
    <span class="pulse" aria-hidden="true"></span>
    <div>
      <p class="muted">Aktiv timer</p>
      <p class="live-name"><%= h(@active["customer_name"] || "Generisk / internt") %><% unless @active["description"].to_s.empty? %> — <%= h(@active["description"]) %><% end %></p>
      <p class="elapsed"><%= erb :_elapsed_span, layout: false, locals: { active: @active } %></p>
    </div>
  </div>
  <form method="post" action="/timer/stop"><button class="btn danger big">■ Stopp timer</button></form>
</section>
<% end %>

<% if @suggestions && !@suggestions.empty? %>
<section class="card sugg-card">
  <div class="card-head"><h2>🤖 Neste grep — la appen peke deg</h2></div>
  <div class="sugg-list">
    <% @suggestions.each do |s| %>
      <a class="sugg-item" href="<%= h(s[:href]) %>">
        <span class="sugg-emoji"><%= s[:icon] %></span>
        <span class="sugg-text"><%= h(s[:text]) %></span>
        <span class="sugg-arrow">→</span>
      </a>
    <% end %>
  </div>
</section>
<% end %>

<section class="card">
  <div class="card-head"><h2>Siste aktivitet</h2></div>
  <div class="activity">
    <% @activity.each do |a| %>
      <div class="activity-item">
        <span class="act-time muted"><%= h(fmt_date(a[:at])) %></span>
        <span class="act-text"><%= h(a[:text]) %></span>
      </div>
    <% end %>
    <% if @activity.empty? %><p class="muted">Ingenting ennå — start en timer eller registrer et salg.</p><% end %>
  </div>
</section>