<%# Kompakte nylige rader: kunde, beskrivelse, varighet, beløp + Gjenta. %>
<% if @entries.empty? %>
  <div class="empty-state"><p>Ingen registreringer i dette utvalget.</p></div>
<% else %>
  <p class="list-sum muted small"><%= @entries.size %> registreringer · sum <%= fmt_minutes(@totals[:minutes]) %> · <%= format_kr(@totals[:amount_ore]) %></p>
  <div class="row-list">
    <% @entries.each do |e| %>
      <div class="row-item">
        <div class="row-main">
          <span class="row-customer"><%= h(e["customer_name"] || "Generisk / internt") %></span>
          <% unless e["description"].to_s.strip.empty? %>
            <span class="row-desc"><%= h(e["description"]) %></span>
          <% end %>
          <% unless e["billable"].to_i == 1 %><span class="tag">ikke fakturerbar</span><% end %>
        </div>
        <div class="row-amt">
          <span class="num"><%= fmt_minutes(e["minutes"]) %></span>
          <span class="num price"><strong><%= format_kr(e["amount_ore"]) %></strong></span>
        </div>
        <div class="row-meta muted"><%= h(fmt_date(e["started_at"])) %></div>
        <div class="row-actions">
          <button type="button" class="btn small gjenta-btn"
                  data-customer="<%= e['customer_id'] ? e['customer_id'] : '' %>"
                  data-desc="<%= h(e['description']) %>"><%= erb :_icon, locals: { name: "refresh", size: 14 } %> Gjenta</button>
          <form method="post" action="/timer/<%= e['id'] %>/delete" onsubmit="return confirm('Slette registreringen?')">
            <button class="btn small danger" title="Slett" aria-label="Slett registrering"><%= erb :_icon, locals: { name: "trash", size: 14 } %></button>
          </form>
        </div>
      </div>
    <% end %>
  </div>
<% end %>