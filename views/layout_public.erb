<!DOCTYPE html>
<html lang="no">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= @title ? h(@title) + " · " : "" %><%= h(@shop_title || setting("shop_title")) %></title>
<link rel="icon" href="data:,">
<link rel="stylesheet" href="/style.css">
<script src="/vendor/htmx.min.js" defer></script>
</head>
<body class="public-page">
<header class="topbar public-topbar">
  <a class="brand" href="/butikk">🛒 <%= h(@shop_title || setting("shop_title")) %></a>
  <nav>
    <a href="/butikk" <%= request.path_info == "/butikk" ? 'class="active"' : "" %>>Butikk</a>
    <% if web_user %>
      <a href="/min-side"><%= h(web_user["name"] || web_user["email"]) %></a>
      <a href="/logout">Logg ut</a>
    <% else %>
      <a href="/login" <%= request.path_info.start_with?("/login") ? 'class="active"' : "" %>>Logg inn</a>
    <% end %>
  </nav>
</header>

<main class="container">
  <% if session[:shop_flash] %>
    <div class="flash" role="status"><%= h(session.delete(:shop_flash)) %></div>
  <% end %>
  <%= yield %>
</main>

<footer class="footer">
  <p><%= h(setting("company_name")) %> · Internt-prissatt butikk — logg inn for pris</p>
</footer>
</body>
</html>