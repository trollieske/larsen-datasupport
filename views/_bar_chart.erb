<%# Inline SVG stolpediagram — fill=var(--accent) så det følger temaet. data: [{label, value}] %>
<% max = [data.map { |d| d[:value] }.max.to_f, 1].max %>
<div class="chart" data-type="bar">
  <svg viewBox="0 0 520 180" role="img" aria-label="Stolpodiagram">
    <defs>
      <linearGradient id="barGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--accent)"/>
        <stop offset="100%" stop-color="var(--accent-hover)"/>
      </linearGradient>
    </defs>
    <% data.each_with_index do |d, i| %>
      <% v = [d[:value].to_f, 0].max %>
      <% h = (v / max) * 130 %>
      <% x = 30 + i * (500.0 / data.length) %>
      <% w = (500.0 / data.length) * 0.62 %>
      <rect x="<%= x %>" y="<%= 152 - h %>" width="<%= w %>" height="<%= h %>" rx="5" fill="url(#barGrad)"/>
      <% if v > 0 %>
        <text x="<%= x + w / 2 %>" y="<%= 142 - h %>" text-anchor="middle" font-size="10" fill="var(--text-tertiary)"><%= v.to_i %></text>
      <% end %>
      <text x="<%= x + w / 2 %>" y="170" text-anchor="middle" font-size="9" fill="var(--text-tertiary)"><%= h(d[:label]) %></text>
    <% end %>
  </svg>
</div>