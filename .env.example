# Kopier til .env og fyll inn. Appen leser miljøvariabler direkte — lokalt kan du
# kjøre: export $(grep -v '^#' .env | xargs) før du starter appen.
# (I produksjon på Fly.io/Render setter du disse som hemmeligheter, se README.)

# Passord for HTTP Basic Auth. Uten denne er appen åpen (kun for lokal utvikling!).
APP_PASSWORD=bytt-meg-til-et-langt-passord

# Hemmelighet for sessions-cookie. Generer en tilfeldig: ruby -e "puts Random.bytes(32).unpack1('H*')"
SESSION_SECRET=bytt-meg-ogsa

# Hvor SQLite-filen ligger. Standard er data/larsen.db ved siden av appen.
# DATABASE_PATH=data/larsen.db

# Port (brukes av puma i produksjon).
# PORT=4567
